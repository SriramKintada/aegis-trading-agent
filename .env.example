# AEGIS Trading Agent — Environment Variables
# Copy to .env and fill in your values
# NEVER commit .env to git!

# ── Network ───────────────────────────────────────────────────────────────────

# Your Alchemy API key (create at alchemy.com)
ALCHEMY_API_KEY=your_alchemy_api_key_here

# RPC endpoints (auto-constructed from ALCHEMY_API_KEY, or override)
BASE_MAINNET_RPC=https://base-mainnet.g.alchemy.com/v2/YOUR_KEY
BASE_SEPOLIA_RPC=https://base-sepolia.g.alchemy.com/v2/YOUR_KEY

# ── Wallet ────────────────────────────────────────────────────────────────────

# BURNER WALLET ONLY — never use your main wallet!
# Generate with: python -c "from eth_account import Account; a=Account.create(); print(a.key.hex(), a.address)"
PRIVATE_KEY=0xyour_burner_wallet_private_key_here

# ── Trading Config ────────────────────────────────────────────────────────────

# Set to "true" for testnet (Base Sepolia), "false" for mainnet
USE_TESTNET=true

# Chain ID: 84532 = Base Sepolia, 8453 = Base Mainnet
CHAIN_ID=84532

# ── AEGIS Contract Addresses (update after deployment) ────────────────────────
AEGIS_CONTROLLER_ADDRESS=
AEGIS_VAULT_ADDRESS=
AEGIS_REPORTER_ADDRESS=

# ── API Keys ──────────────────────────────────────────────────────────────────

# CryptoPanic (cryptopanic.com/developers/api — free tier)
CRYPTOPANIC_API_KEY=your_cryptopanic_api_key_here

# Uniswap Trading API (portal.uniswap.org — optional)
UNISWAP_API_KEY=your_uniswap_api_key_here

# Pinata (IPFS for ERC-8004 agent card — pinata.cloud)
PINATA_JWT=your_pinata_jwt_here

# bond.credit (hackathon Discord for API access)
BOND_CREDIT_API_KEY=your_bond_credit_key_here
